<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SistemaGestionProduccion.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Sistema Gestión Producción</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />

    <!-- ESTILOS DEL SISTEMA -->
    <link href="/Styles/style.css" rel="stylesheet" />
    <link href="/Styles/dashboard.css" rel="stylesheet" />
    <link href="/Styles/pedidos.css" rel="stylesheet" />
    <link href="/Styles/kanban.css" rel="stylesheet" />
    <link href="/Styles/responsive.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body>

<form runat="server">

    <div class="app-layout">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="sidebar-header">
                <h2>Brand Solutions</h2>
                <span>ERP Producción</span>
            </div>

            <nav class="sidebar-nav">

                <a id="menuDashboard"
   runat="server"
   href="/Pages/Dashboard.aspx">

    <i class="fas fa-chart-line"></i>
    Dashboard

</a>

                <a href="/Pages/Kanban.aspx">
    <i class="fas fa-columns"></i>
    Kanban
</a>

               <a id="menuClientes"
   runat="server"
   href="/Pages/Clientes.aspx">

    <i class="fas fa-address-book"></i>
    Clientes

</a>

                <a href="/Pages/Pedidos.aspx">
                    <i class="fas fa-clipboard-list"></i>
                    Pedidos
                </a>

                <a id="menuDiseno"
   runat="server"
   href="/Pages/Diseno.aspx">

    <i class="fas fa-palette"></i>
    Diseño

</a>

                <a id="menuProduccion"
   runat="server"
   href="/Pages/Produccion.aspx">

    <i class="fas fa-industry"></i>
    Producción

</a>

                <a id="menuPagos"
   runat="server"
   href="/Pages/Pagos.aspx">

    <i class="fas fa-money-bill-wave"></i>
    Pagos

</a>

                <a href="/Pages/Calendario.aspx">
                    <i class="fas fa-calendar"></i>
                    Calendario
                </a>

                <a id="menuReportes"
   runat="server"
   href="/Pages/Reportes.aspx">

    <i class="fas fa-chart-bar"></i>
    Reportes

</a>

                <a id="menuUsuarios"
   runat="server"
   href="/Pages/Usuarios.aspx">

    <i class="fas fa-users"></i>
    Usuarios

</a>

            </nav>

            <div class="sidebar-footer">
    <i class="fas fa-user-circle"></i>

    <asp:Label
        ID="lblUsuarioSidebar"
        runat="server"
        Text="Usuario" />
</div>

        </aside>

        <!-- Contenido -->
        <main class="main-area">

            <header class="topbar">

                <div class="search-box">
                    <input type="text" placeholder="Buscar..." />
                </div>

                <div class="topbar-right">

    <a href="/Pages/Notificaciones.aspx"
       class="notification-btn">

        <i class="fas fa-bell"></i>

        <span class="notification-badge">

            <asp:Label
                ID="lblNotificaciones"
                runat="server"
                Text="0" />

        </span>

    </a>

    <div class="user-info">

        <i class="fas fa-user-circle"></i>

        <asp:Label
            ID="lblUsuario"
            runat="server"
            Text="Administrador" />

        <asp:LinkButton
            ID="btnCerrarSesion"
            runat="server"
            CssClass="logout-btn"
            OnClick="btnCerrarSesion_Click">

            <i class="fas fa-sign-out-alt"></i>
            Salir

        </asp:LinkButton>

    </div>

</div>
            </header>

            <section class="page-content">

                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>

            </section>

        </main>

    </div>

</form>

</body>
</html>
