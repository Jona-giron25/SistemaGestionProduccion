<%@ Master Language="C#" AutoEventWireup="true"
CodeBehind="Login.Master.cs"
Inherits="SistemaGestionProduccion.LoginMaster" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">

<head runat="server">

```
<meta charset="utf-8" />

<title>
    Sistema Gestión Producción
</title>

<meta name="viewport"
      content="width=device-width, initial-scale=1" />

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      rel="stylesheet" />

<asp:ContentPlaceHolder ID="head"
                        runat="server">
</asp:ContentPlaceHolder>

<style>

    *{
        margin:0;
        padding:0;
        box-sizing:border-box;
        font-family:'Segoe UI',sans-serif;
    }

    body{
        background:#f1f5f9;
    }

    .login-wrapper{
        min-height:100vh;
        display:flex;
        justify-content:center;
        align-items:center;
        padding:20px;
    }

    .login-card{
        width:100%;
        max-width:650px;
        background:white;
        border-radius:20px;
        padding:50px;
        box-shadow:0 15px 40px rgba(0,0,0,.08);
    }

    .logo{
        text-align:center;
        margin-bottom:40px;
    }

    .logo h1{
        color:#2563eb;
        font-size:56px;
        font-weight:700;
        margin-bottom:10px;
    }

    .logo p{
        color:#64748b;
        font-size:24px;
    }
    .login-container{
    width:100%;
    display:flex;
    justify-content:center;
    align-items:center;
}

.login-card{
    width:100%;
    max-width:700px;
    background:white;
    border-radius:20px;
    padding:50px;
    box-shadow:0 15px 40px rgba(0,0,0,.08);
}

.logo-section{
    text-align:center;
    margin-bottom:40px;
}

.logo-section h1{
    color:#2563eb;
    font-size:60px;
    font-weight:700;
    margin-bottom:10px;
}

.logo-section p{
    color:#64748b;
    font-size:18px;
    line-height:1.5;
}

.form-group{
    margin-bottom:25px;
}

.form-group label{
    display:block;
    margin-bottom:8px;
    font-weight:600;
    color:#1e293b;
}

.form-control{
    width:100%;
    padding:16px;
    border:1px solid #dbe2ea;
    border-radius:12px;
    font-size:16px;
}

.form-control:focus{
    outline:none;
    border-color:#2563eb;
}

.btn-login{
    display:block;
    width:100%;
    background:#2563eb;
    color:white;
    text-decoration:none;
    text-align:center;
    padding:16px;
    border-radius:12px;
    font-size:18px;
    font-weight:600;
    margin-top:15px;
    transition:.3s;
}

.btn-login:hover{
    background:#1d4ed8;
}

</style>
```

</head>

<body>

```
<form id="form1" runat="server">

    <div class="login-wrapper">

        <asp:ContentPlaceHolder ID="MainContent"
                                runat="server">
        </asp:ContentPlaceHolder>

    </div>

</form>
```

</body>

</html>
