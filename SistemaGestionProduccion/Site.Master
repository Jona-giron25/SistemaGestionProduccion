<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SistemaGestionProduccion.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Sistema Gestión Producción</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />

    <!-- ESTILOS DEL SISTEMA -->
    <link href="/Styles/style.css" rel="stylesheet" />
    <link href="/Styles/dashboard.css" rel="stylesheet" />
    <link href="/Styles/pedidos.css" rel="stylesheet" />
    <link href="/Styles/kanban.css" rel="stylesheet" />
    <link href="/Styles/responsive.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body>

<form runat="server">

    <div class="app-layout">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="sidebar-header">
                <h2>Brand Solutions</h2>
                <span>ERP Producción</span>
            </div>

            <nav class="sidebar-nav">

                <a href="/Pages/Dashboard.aspx">
                    <i class="fas fa-chart-line"></i>
                    Dashboard
                </a>

                <a href="/Pages/Clientes.aspx">
                    <i class="fas fa-address-book"></i>
                    Clientes
                </a>

                <a href="/Pages/Pedidos.aspx">
                    <i class="fas fa-clipboard-list"></i>
                    Pedidos
                </a>

                <a href="/Pages/Diseno.aspx">
                    <i class="fas fa-palette"></i>
                    Diseño
                </a>

                <a href="/Pages/Produccion.aspx">
                    <i class="fas fa-industry"></i>
                    Producción
                </a>

                <a href="/Pages/Pagos.aspx">
                    <i class="fas fa-money-bill-wave"></i>
                    Pagos
                </a>

                <a href="/Pages/Calendario.aspx">
                    <i class="fas fa-calendar"></i>
                    Calendario
                </a>

                <a href="/Pages/Reportes.aspx">
                    <i class="fas fa-chart-bar"></i>
                    Reportes
                </a>

                <a href="/Pages/Usuarios.aspx">
                    <i class="fas fa-users"></i>
                    Usuarios
                </a>

            </nav>

            <div class="sidebar-footer">
                <i class="fas fa-user-circle"></i>
                César Girón
            </div>

        </aside>

        <!-- Contenido -->
        <main class="main-area">

            <header class="topbar">

                <div class="search-box">
                    <input type="text" placeholder="Buscar..." />
                </div>

                <div class="topbar-right">

                    <button class="notification-btn">
                        <i class="fas fa-bell"></i>
                    </button>

                    <div class="user-info">
                        <i class="fas fa-user-circle"></i>
                        Administrador
                    </div>

                </div>

            </header>

            <section class="page-content">

                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>

            </section>

        </main>

    </div>

</form>

</body>
</html>
